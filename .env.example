PORT=17842
TZ=Asia/Shanghai
# 至少 32 个字符；生产环境请替换并妥善备份，否则无法解密已保存的凭据
CREDENTIAL_KEY=change-me-to-a-long-random-secret-key-please
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=change-me-to-another-long-random-secret-key
COOKIE_SECURE=false
CHECKIN_ENABLED=true
CHECKIN_TIME=02:00
HTTP_TIMEOUT_SECONDS=20

# ---- 最新模型探活（DeepSeek / GLM / ChatGPT / Claude / Gemini）----
# CLIProxyAPI 地址与管理密钥：用于读取各公益站的 base-url / api-key / 模型
CPA_BASE_URL=https://cli.5577472.xyz
CPA_MANAGEMENT_KEY=
MODEL_PROBE_ENABLED=true
# 首次启动时的默认值，之后以面板里保存的设置为准
MODEL_PROBE_INTERVAL_MINUTES=60
MODEL_PROBE_TIMEOUT_SECONDS=40
MODEL_PROBE_CONCURRENCY=4
# 可选：设置后可用 Bearer Token 免登录调用 GET /api/models/available
MODEL_STATUS_TOKEN=
# 测活后自动更新 CPA（接入签到站、增删对外模型、停用/启用失效站点）
CPA_SYNC_ENABLED=true
CPA_SYNC_FAIL_THRESHOLD=3
